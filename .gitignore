__pycache__/
*.pyc
.venv/
venv/
.env
.pytest_cache/
data/raw/*.db
data/raw/*.json
# Committed on purpose, unlike etimad.db itself: lets a scheduled GitHub
# Actions run (ephemeral runner, no persistent db) resume mid-pagination
# across runs within the same snapshot instead of restarting from page 1.
# One per sort direction (checkpoint_current_tenders_<direction>.json).
!data/raw/checkpoint_current_tenders_*.json
data/processed/*.csv
!data/processed/tender_details.csv
!data/processed/tender_bids.csv
!data/processed/tender_detail_failures.csv
data/processed/*.parquet
data/processed/*.csv.gz
# Deduplicated + gzipped (see export_current_tenders_csv.py) to stay under
# GitHub's 100MB push limit as the archive grows - confirmed 2026-11-18 a
# plain, full-history current_tenders.csv exceeded it.
!data/processed/current_tenders.csv.gz
