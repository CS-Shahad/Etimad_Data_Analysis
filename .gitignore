__pycache__/
*.pyc
.venv/
venv/
.env
.pytest_cache/
data/raw/*.db
data/raw/*.json
# Committed on purpose, unlike etimad.db itself: lets a scheduled GitHub
# Actions run (ephemeral runner, no persistent db) resume mid-pagination
# across runs within the same snapshot instead of restarting from page 1.
!data/raw/checkpoint_current_tenders.json
data/processed/*.csv
!data/processed/current_tenders.csv
!data/processed/tender_details.csv
!data/processed/tender_bids.csv
!data/processed/tender_detail_failures.csv
data/processed/*.parquet
